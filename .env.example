# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings > API). O .env.local NÃO vai para o Git.

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# NUNCA coloque a service_role key aqui: tudo com prefixo NEXT_PUBLIC_ vai
# para o navegador de qualquer visitante.
